                   'mode': 'adapterMode', 'token': 'responseEnvelope'}[mutation[9:]]
            d['response'][key] = ({'kind': 'symbolic-partial/v1', 'token': '0x'+'ab'*32} if key == 'responseEnvelope'
                                  else '1' if key == 'keyEpoch' else 'abe-real' if key == 'adapterMode' else '0x'+'ab'*32)
