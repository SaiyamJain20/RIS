            row['createdAt'] = '109'
            for e in d['after_release']['worker']['events']: e['timestamp'] = '109'
        if mutation == 'event-time': d['after_release']['worker']['events'][1]['timestamp'] = '113'
        if mutation == 'event-expired': d['after_release']['worker']['events'][1]['timestamp'] = '140'
