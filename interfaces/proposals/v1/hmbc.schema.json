{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "HMBC v1 candidate NOT frozen",
  "$defs": {
    "Address": {
      "type": "string",
      "pattern": "^0x[0-9a-f]{40}$",
      "maxLength": 42
    },
    "Hash": {
      "type": "string",
      "pattern": "^0x[0-9a-f]{64}$",
      "maxLength": 66
    },
    "Signature": {
      "type": "string",
      "pattern": "^0x[0-9a-f]{130}$",
      "format": "canonical-signature"
    },
    "Uint8": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)$",
      "maxLength": 3,
      "format": "uint8"
    },
    "Uint64": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)$",
      "maxLength": 20,
      "format": "uint64"
    },
    "Uint256": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)$",
      "maxLength": 78,
      "format": "uint256"
    },
    "AccessRequest": {
      "type": "object",
      "properties": {
        "sourceChainId": {
          "$ref": "#/$defs/Uint256"
        },
        "destinationChainId": {
          "$ref": "#/$defs/Uint256"
        },
        "psc": {
          "$ref": "#/$defs/Address"
        },
        "kssc": {
          "$ref": "#/$defs/Address"
        },
        "gid": {
          "$ref": "#/$defs/Address"
        },
        "dataId": {
          "$ref": "#/$defs/Hash"
        },
        "action": {
          "$ref": "#/$defs/Uint8"
        },
        "policyVersion": {
          "$ref": "#/$defs/Uint64"
        },
        "authEpoch": {
          "$ref": "#/$defs/Uint64"
        },
        "keyEpoch": {
          "const": "0"
        },
        "nonce": {
          "$ref": "#/$defs/Uint256"
        },
        "expiresAt": {
          "$ref": "#/$defs/Uint64"
        },
        "recipientKeyHash": {
          "$ref": "#/$defs/Hash"
        }
      },
      "required": [
        "sourceChainId",
        "destinationChainId",
        "psc",
        "kssc",
        "gid",
        "dataId",
        "action",
        "policyVersion",
        "authEpoch",
        "keyEpoch",
        "nonce",
        "expiresAt",
        "recipientKeyHash"
      ],
      "additionalProperties": false,
      "x-eip712Type": "AccessRequest(uint256 sourceChainId,uint256 destinationChainId,address psc,address kssc,address gid,bytes32 dataId,uint8 action,uint64 policyVersion,uint64 authEpoch,uint64 keyEpoch,uint256 nonce,uint64 expiresAt,bytes32 recipientKeyHash)"
    },
    "AccessDecision": {
      "type": "object",
      "properties": {
        "requestDigest": {
          "$ref": "#/$defs/Hash"
        },
        "result": {
          "enum": [
            "0",
            "1"
          ]
        },
        "credentialDigest": {
          "$ref": "#/$defs/Hash"
        },
        "stateSequence": {
          "$ref": "#/$defs/Uint64"
        },
        "witnessSetVersion": {
          "const": "1"
        },
        "sourceBlockNumber": {
          "$ref": "#/$defs/Uint256"
        },
        "sourceBlockHash": {
          "$ref": "#/$defs/Hash"
        },
        "expiresAt": {
          "$ref": "#/$defs/Uint64"
        }
      },
      "required": [
        "requestDigest",
        "result",
        "credentialDigest",
        "stateSequence",
        "witnessSetVersion",
        "sourceBlockNumber",
        "sourceBlockHash",
        "expiresAt"
      ],
      "additionalProperties": false,
      "x-eip712Type": "AccessDecision(bytes32 requestDigest,uint8 result,bytes32 credentialDigest,uint64 stateSequence,uint64 witnessSetVersion,uint256 sourceBlockNumber,bytes32 sourceBlockHash,uint64 expiresAt)"
    },
    "StateCheckpoint": {
      "type": "object",
      "properties": {
        "sequence": {
          "$ref": "#/$defs/Uint64"
        },
        "authEpoch": {
          "$ref": "#/$defs/Uint64"
        },
        "policyVersion": {
          "$ref": "#/$defs/Uint64"
        },
        "keyEpoch": {
          "const": "0"
        },
        "witnessSetVersion": {
          "const": "1"
        },
        "sourceChainId": {
          "$ref": "#/$defs/Uint256"
        },
        "psc": {
          "$ref": "#/$defs/Address"
        },
        "sourceBlockNumber": {
          "$ref": "#/$defs/Uint256"
        },
        "sourceBlockHash": {
          "$ref": "#/$defs/Hash"
        },
        "expiresAt": {
          "$ref": "#/$defs/Uint64"
        }
      },
      "required": [
        "sequence",
        "authEpoch",
        "policyVersion",
        "keyEpoch",
        "witnessSetVersion",
        "sourceChainId",
        "psc",
        "sourceBlockNumber",
        "sourceBlockHash",
        "expiresAt"
      ],
      "additionalProperties": false,
      "x-eip712Type": "StateCheckpoint(uint64 sequence,uint64 authEpoch,uint64 policyVersion,uint64 keyEpoch,uint64 witnessSetVersion,uint256 sourceChainId,address psc,uint256 sourceBlockNumber,bytes32 sourceBlockHash,uint64 expiresAt)"
    },
    "Registration": {
      "type": "object",
      "properties": {
        "gid": {
          "$ref": "#/$defs/Address"
        },
        "certDigest": {
          "$ref": "#/$defs/Hash"
        },
        "recipientKeyHash": {
          "$ref": "#/$defs/Hash"
        },
        "expiresAt": {
          "$ref": "#/$defs/Uint64"
        }
      },
      "required": [
        "gid",
        "certDigest",
        "recipientKeyHash",
        "expiresAt"
      ],
      "additionalProperties": false,
      "x-eip712Type": "Registration(address gid,bytes32 certDigest,bytes32 recipientKeyHash,uint64 expiresAt)"
    },
    "RoleCertificate": {
      "type": "object",
      "properties": {
        "issuer": {
          "$ref": "#/$defs/Address"
        },
        "gid": {
          "$ref": "#/$defs/Address"
        },
        "roles": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Hash"
          },
          "minItems": 1
        },
        "serial": {
          "$ref": "#/$defs/Uint64"
        },
        "validFrom": {
          "$ref": "#/$defs/Uint64"
        },
        "validUntil": {
          "$ref": "#/$defs/Uint64"
        }
      },
      "required": [
        "issuer",
        "gid",
        "roles",
        "serial",
        "validFrom",
        "validUntil"
      ],
      "additionalProperties": false,
      "x-eip712Type": "RoleCertificate(address issuer,address gid,bytes32[] roles,uint64 serial,uint64 validFrom,uint64 validUntil)"
    },
    "SignedRoleCertificate": {
      "type": "object",
      "properties": {
        "cert": {
          "$ref": "#/$defs/RoleCertificate"
        },
        "signature": {
          "$ref": "#/$defs/Signature"
        }
      },
      "required": [
        "cert",
        "signature"
      ],
      "additionalProperties": false
    },
    "RevocationList": {
      "type": "object",
      "properties": {
        "authority": {
          "$ref": "#/$defs/Address"
        },
        "version": {
          "$ref": "#/$defs/Uint64"
        },
        "validUntil": {
          "$ref": "#/$defs/Uint64"
        },
        "revokedSerials": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Uint64"
          },
          "minItems": 0
        }
      },
      "required": [
        "authority",
        "version",
        "validUntil",
        "revokedSerials"
      ],
      "additionalProperties": false,
      "x-eip712Type": "RevocationList(address authority,uint64 version,uint64 validUntil,uint64[] revokedSerials)"
    },
    "TempAclEntry": {
      "type": "object",
      "properties": {
        "gid": {
          "$ref": "#/$defs/Address"
        },
        "role": {
          "$ref": "#/$defs/Hash"
        },
        "validFrom": {
          "$ref": "#/$defs/Uint64"
        },
        "validUntil": {
          "$ref": "#/$defs/Uint64"
        }
      },
      "required": [
        "gid",
        "role",
        "validFrom",
        "validUntil"
      ],
      "additionalProperties": false,
      "x-eip712Type": "TempAclEntry(address gid,bytes32 role,uint64 validFrom,uint64 validUntil)"
    },
    "TemporalAcl": {
      "type": "object",
      "properties": {
        "authority": {
          "$ref": "#/$defs/Address"
        },
        "version": {
          "$ref": "#/$defs/Uint64"
        },
        "validUntil": {
          "$ref": "#/$defs/Uint64"
        },
        "entries": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/TempAclEntry"
          },
          "minItems": 0
        }
      },
      "required": [
        "authority",
        "version",
        "validUntil",
        "entries"
      ],
      "additionalProperties": false,
      "x-eip712Type": "TemporalAcl(address authority,uint64 version,uint64 validUntil,TempAclEntry[] entries)TempAclEntry(address gid,bytes32 role,uint64 validFrom,uint64 validUntil)"
    },
    "TemporalClaim": {
      "type": "object",
      "properties": {
        "authority": {
          "$ref": "#/$defs/Address"
        },
        "role": {
          "$ref": "#/$defs/Hash"
        }
      },
      "required": [
        "authority",
        "role"
      ],
      "additionalProperties": false
    },
    "CredentialBundle": {
      "type": "object",
      "properties": {
        "certificates": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SignedRoleCertificate"
          },
          "minItems": 0
        },
        "temporalClaims": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/TemporalClaim"
          },
          "minItems": 0
        }
      },
      "required": [
        "certificates",
        "temporalClaims"
      ],
      "additionalProperties": false
    },
    "CredentialRecord": {
      "type": "object",
      "properties": {
        "issuer": {
          "$ref": "#/$defs/Address"
        },
        "role": {
          "$ref": "#/$defs/Hash"
        },
        "kind": {
          "enum": [
            "1",
            "2"
          ]
        },
        "serial": {
          "$ref": "#/$defs/Uint64"
        },
        "anchorVersion": {
          "$ref": "#/$defs/Uint64"
        },
        "validUntil": {
          "$ref": "#/$defs/Uint64"
        }
      },
      "required": [
        "issuer",
        "role",
        "kind",
        "serial",
        "anchorVersion",
        "validUntil"
      ],
      "additionalProperties": false,
      "x-eip712Type": "CredentialRecord(address issuer,bytes32 role,uint8 kind,uint64 serial,uint64 anchorVersion,uint64 validUntil)"
    },
    "CredentialRecords": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/CredentialRecord"
      },
      "minItems": 0
    },
    "DecisionCertificate": {
      "type": "object",
      "properties": {
        "decision": {
          "$ref": "#/$defs/AccessDecision"
        },
        "signatures": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Signature"
          },
          "minItems": 1,
          "maxItems": 1
        }
      },
      "required": [
        "decision",
        "signatures"
      ],
      "additionalProperties": false
    },
    "ForwardedRequest": {
      "type": "object",
      "properties": {
        "pbcRequestId": {
          "$ref": "#/$defs/Hash"
        },
        "gid": {
          "$ref": "#/$defs/Address"
        },
        "dataId": {
          "$ref": "#/$defs/Hash"
        },
        "action": {
          "$ref": "#/$defs/Uint8"
        }
      },
      "required": [
        "pbcRequestId",
        "gid",
        "dataId",
        "action"
      ],
      "additionalProperties": false
    },
    "GrantReceipt": {
      "type": "object",
      "properties": {
        "requestDigest": {
          "$ref": "#/$defs/Hash"
        },
        "grantId": {
          "$ref": "#/$defs/Hash"
        },
        "gid": {
          "$ref": "#/$defs/Address"
        },
        "dataId": {
          "$ref": "#/$defs/Hash"
        },
        "keyEpoch": {
          "const": "0"
        },
        "grantExpiresAt": {
          "type": "string",
          "pattern": "^[1-9][0-9]*$",
          "maxLength": 20,
          "format": "uint64"
        },
        "witnessSetVersion": {
          "const": "1"
        },
        "dbcChainId": {
          "$ref": "#/$defs/Uint256"
        },
        "kssc": {
          "$ref": "#/$defs/Address"
        },
        "dbcBlockNumber": {
          "$ref": "#/$defs/Uint256"
        },
        "dbcBlockHash": {
          "$ref": "#/$defs/Hash"
        }
      },
      "required": [
        "requestDigest",
        "grantId",
        "gid",
        "dataId",
        "keyEpoch",
        "grantExpiresAt",
        "witnessSetVersion",
        "dbcChainId",
        "kssc",
        "dbcBlockNumber",
        "dbcBlockHash"
      ],
      "additionalProperties": false,
      "x-status": "A1-0008 revision 2 capability/semantics ACKs A3-0005 and A2-0002; A1-0011 implemented. Candidate NOT frozen; past allowed grant, no delivery proof.",
      "x-eip712Type": "GrantReceipt(bytes32 requestDigest,bytes32 grantId,address gid,bytes32 dataId,uint64 keyEpoch,uint64 grantExpiresAt,uint64 witnessSetVersion,uint256 dbcChainId,address kssc,uint256 dbcBlockNumber,bytes32 dbcBlockHash)"
    },
    "Error": {
      "type": "object",
      "properties": {
        "code": {
          "enum": [
            "BAD_SIGNATURE",
            "WRONG_SUBJECT",
            "WRONG_DESTINATION",
            "UNKNOWN_AUTHORITY",
            "STALE_ANCHOR",
            "STALE_STATE",
            "EXPIRED",
            "REPLAY",
            "POLICY_DENIED",
            "INSUFFICIENT_QUORUM",
            "DUPLICATE_SIGNER",
            "WRONG_EPOCH",
            "NOT_COMMITTED",
            "ADAPTER_UNAVAILABLE",
            "NOT_IMPLEMENTED_IN_PHASE",
            "UNAUTHORIZED_CALLER",
            "NOT_REGISTERED",
            "ALREADY_REGISTERED",
            "REVOKED",
            "MALFORMED",
            "WRONG_PROFILE"
          ]
        },
        "message": {
          "type": "string"
        }
      },
      "required": [
        "code",
        "message"
      ],
      "additionalProperties": false
    },
    "AdapterResponse": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "const": "v1"
        },
        "ok": {
          "type": "boolean"
        },
        "result": {
          "type": [
            "object",
            "null"
          ]
        },
        "error": {
          "anyOf": [
            {
              "$ref": "#/$defs/Error"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "schemaVersion",
        "ok",
        "result",
        "error"
      ],
      "additionalProperties": false,
      "oneOf": [
        {
          "properties": {
            "ok": {
              "const": true
            },
            "result": {
              "type": "object"
            },
            "error": {
              "type": "null"
            }
          }
        },
        {
          "properties": {
            "ok": {
              "const": false
            },
            "result": {
              "type": "null"
            },
            "error": {
              "$ref": "#/$defs/Error"
            }
          }
        }
      ]
    },
    "FileHash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "maxLength": 64
    },
    "FileHashes": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/FileHash"
      }
    },
    "LedgerAbiEntry": {
      "type": "object",
      "properties": {
        "abi": {
          "type": "string",
          "minLength": 1
        },
        "abiSha256": {
          "$ref": "#/$defs/FileHash"
        },
        "runtimeBytes": {
          "type": "integer",
          "minimum": 0
        },
        "runtimeSha256": {
          "$ref": "#/$defs/FileHash"
        },
        "source": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "abi",
        "abiSha256",
        "runtimeBytes",
        "runtimeSha256",
        "source"
      ],
      "additionalProperties": false
    },
    "LedgerAbiContracts": {
      "type": "object",
      "properties": {
        "LSC": {
          "$ref": "#/$defs/LedgerAbiEntry"
        },
        "TMSC": {
          "$ref": "#/$defs/LedgerAbiEntry"
        },
        "RSC": {
          "$ref": "#/$defs/LedgerAbiEntry"
        },
        "PSC": {
          "$ref": "#/$defs/LedgerAbiEntry"
        },
        "ACSC": {
          "$ref": "#/$defs/LedgerAbiEntry"
        },
        "KSSC": {
          "$ref": "#/$defs/LedgerAbiEntry"
        }
      },
      "required": [
        "LSC",
        "TMSC",
        "RSC",
        "PSC",
        "ACSC",
        "KSSC"
      ],
      "additionalProperties": false
    },
    "LedgerSourceHashes": {
      "type": "object",
      "properties": {
        "src/ACSC.sol": {
          "$ref": "#/$defs/FileHash"
        },
        "src/DecisionVerifier.sol": {
          "$ref": "#/$defs/FileHash"
        },
        "src/KSSC.sol": {
          "$ref": "#/$defs/FileHash"
        },
        "src/LSC.sol": {
          "$ref": "#/$defs/FileHash"
        },
        "src/PSC.sol": {
          "$ref": "#/$defs/FileHash"
        },
        "src/RSC.sol": {
          "$ref": "#/$defs/FileHash"
        },
        "src/TMSC.sol": {
          "$ref": "#/$defs/FileHash"
        },
        "src/lib/Bootstrapped.sol": {
          "$ref": "#/$defs/FileHash"
        },
        "src/lib/SigLib.sol": {
          "$ref": "#/$defs/FileHash"
        },
        "src/types/ProtocolTypes.sol": {
          "$ref": "#/$defs/FileHash"
        }
      },
      "required": [
        "src/ACSC.sol",
        "src/DecisionVerifier.sol",
        "src/KSSC.sol",
        "src/LSC.sol",
        "src/PSC.sol",
        "src/RSC.sol",
        "src/TMSC.sol",
        "src/lib/Bootstrapped.sol",
        "src/lib/SigLib.sol",
        "src/types/ProtocolTypes.sol"
      ],
      "additionalProperties": false
    },
    "LedgerCompiler": {
      "type": "object",
      "properties": {
        "solc": {
          "type": "string",
          "minLength": 1
        },
        "evmVersion": {
          "type": "string",
          "minLength": 1
        },
        "optimizer": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "runs": {
              "type": "integer",
              "minimum": 0
            }
          },
          "required": [
            "enabled",
            "runs"
          ],
          "additionalProperties": false
        },
        "viaIR": {
          "type": "boolean"
        }
      },
      "required": [
        "solc",
        "evmVersion",
        "optimizer",
        "viaIR"
      ],
      "additionalProperties": false
    },
    "LedgerAuthority": {
      "type": "object",
      "properties": {
        "id": {
          "enum": [
            "H1",
            "H2",
            "H3",
            "H4"
          ]
        },
        "root": {
          "$ref": "#/$defs/Address"
        },
        "caAdmins": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Address"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "rootKeyLabel": {
          "type": "string",
          "minLength": 1
        },
        "caAdminKeyLabel": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "id",
        "root",
        "caAdmins",
        "rootKeyLabel",
        "caAdminKeyLabel"
      ],
      "additionalProperties": false
    },
    "LedgerWitnessSet": {
      "type": "object",
      "properties": {
        "version": {
          "const": "1"
        },
        "threshold": {
          "const": "1"
        },
        "witnesses": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Address"
          },
          "minItems": 1,
          "maxItems": 1
        },
        "keyLabels": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "maxItems": 1
        },
        "usedBy": {
          "const": "repaired-e only"
        }
      },
      "required": [
        "version",
        "threshold",
        "witnesses",
        "keyLabels",
        "usedBy"
      ],
      "additionalProperties": false
    },
    "LedgerFixture": {
      "type": "object",
      "properties": {
        "keyDerivation": {
          "type": "string",
          "minLength": 1
        },
        "authorities": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/LedgerAuthority"
          },
          "minItems": 4,
          "maxItems": 4
        },
        "relay": {
          "type": "object",
          "properties": {
            "address": {
              "$ref": "#/$defs/Address"
            },
            "keyLabel": {
              "type": "string",
              "minLength": 1
            },
            "roles": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "minItems": 1
            }
          },
          "required": [
            "address",
            "keyLabel",
            "roles"
          ],
          "additionalProperties": false
        },
        "witnessSet": {
          "$ref": "#/$defs/LedgerWitnessSet"
        },
        "policyVersion": {
          "$ref": "#/$defs/Uint64"
        },
        "keyEpoch": {
          "const": "0"
        },
        "ttlSeconds": {
          "type": "object",
          "properties": {
            "requestMax": {
              "const": "30"
            },
            "decision": {
              "const": "30"
            },
            "checkpointMax": {
              "const": "60"
            },
            "paperGrant": {
              "const": "30"
            }
          },
          "required": [
            "requestMax",
            "decision",
            "checkpointMax",
            "paperGrant"
          ],
          "additionalProperties": false
        },
        "roles": {
          "type": "object",
          "properties": {
            "Doctor": {
              "type": "string",
              "minLength": 1
            },
            "OnDuty": {
              "type": "string",
              "minLength": 1
            },
            "Researcher": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "Doctor",
            "OnDuty",
            "Researcher"
          ],
