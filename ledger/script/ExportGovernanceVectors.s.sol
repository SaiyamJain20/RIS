pragma solidity 0.8.37;

import {Vm, VM_ADDRESS} from "../test/utils/Vm.sol";
import {
    Profile,
    LogDetailMode,
    ErrorCode,
    Rejected,
    HMBCHash,
    GovernanceAction,
    GOV_ADD_AUTHORITY,
    GOV_REMOVE_AUTHORITY,
    GOV_SET_CA_ADMINS
} from "../src/types/ProtocolTypes.sol";
import {LSC} from "../src/LSC.sol";
import {TMSC} from "../src/TMSC.sol";
import {Governance} from "../src/Governance.sol";
import {FixtureConfig} from "./FixtureConfig.sol";

/// A-F1 governance vectors (design 2.2 section 8), computed by the ledger's Solidity encoder.
/// Run: forge script script/ExportGovernanceVectors.s.sol --root ledger   (no broadcast, no chain)
/// Writes exports/vectors/eip712-f-governance.json. A sealed REPAIRED_F TMSC and Governance are deployed in
/// the script's in-memory EVM (PBC chain id 18545, the fixture's authorities, witness-1..4, q = 3), so every
/// boundary vector carries the code the contract actually returned, next to the design's expected code.
/// Separate from ExportVectors.s.sol so the E vector files cannot change. Keys are TEST-ONLY.
contract ExportGovernanceVectors {
    Vm internal constant vm = Vm(VM_ADDRESS);
    uint64 internal constant T0 = 1_800_000_000;
    string[22] internal CODES = [
        "NONE", "BAD_SIGNATURE", "WRONG_SUBJECT", "WRONG_DESTINATION", "UNKNOWN_AUTHORITY", "STALE_ANCHOR",
        "STALE_STATE", "EXPIRED", "REPLAY", "POLICY_DENIED", "INSUFFICIENT_QUORUM", "DUPLICATE_SIGNER",
        "WRONG_EPOCH", "NOT_COMMITTED", "ADAPTER_UNAVAILABLE", "NOT_IMPLEMENTED_IN_PHASE", "UNAUTHORIZED_CALLER",
        "NOT_REGISTERED", "ALREADY_REGISTERED", "REVOKED", "MALFORMED", "WRONG_PROFILE"
    ];

    Governance internal gov;
    uint256[] internal pks;
    bool internal mismatch;
    address internal h1;
    address internal h3;
    address internal a1;

    function key(string memory label) internal pure returns (uint256) {
        return FixtureConfig.key(label);
    }

    function run() external {
        vm.chainId(FixtureConfig.PBC_CHAIN_ID);
        vm.warp(T0);
        _deploy();
        string[] memory actions = new string[](3);
        actions[0] = _signed("add", _action(GOV_ADD_AUTHORITY, vm.addr(key("H5-root")), _one(vm.addr(key("H5-ca-admin"))), 1));
        actions[1] = _signed("remove", _action(GOV_REMOVE_AUTHORITY, vm.addr(key("H3-root")), new address[](0), 1));
        actions[2] = _signed("set", _action(GOV_SET_CA_ADMINS, vm.addr(key("H1-root")), _one(vm.addr(key("H1-ca-admin-2"))), 1));
        string memory head = string.concat(
            "{",
            _kv("schema", _q("hmbc-ledger-f-governance-vectors/v1")),
            ",",
            _kv("status", _q("generated by script/ExportGovernanceVectors.s.sol in an in-memory EVM; TEST-ONLY keys; not a deployment")),
            ",",
            _kv("typeString", _q("GovernanceAction(uint8 action,address root,address[] admins,uint64 nonce,uint64 witnessSetVersion,uint64 expiresAt)")),
            ",",
            _kv("typeHash", _b32(HMBCHash.GOVERNANCE_ACTION_TYPEHASH)),
            ",",
            _kv("domain", _domain())
        );
        string memory doc = string.concat(
            head,
            ",",
            _kv("witnesses", _witnesses()),
            ",",
            _kv("threshold", _q("3")),
            ",",
            _kv("blockTimestamp", _u(block.timestamp)),
            ",",
            _kv("actions", _arr(actions)),
            ",",
            _kv("boundary", _boundary()),
            ",",
            _kv("bit6", _bit6()),
            "}"
        );
        require(!mismatch, "an observed boundary code differs from the expected code");
        vm.writeFile("exports/vectors/eip712-f-governance.json", string.concat(doc, "\n"));
    }

    // ------------------------------------------------------------------ in-memory deployment

    function _deploy() internal {
        for (uint256 i = 0; i < 4; i++) {
            pks.push(key(FixtureConfig.witnessLabel(i)));
        }
        address[] memory ws = new address[](4);
        for (uint256 i = 0; i < 4; i++) {
            ws[i] = vm.addr(pks[i]);
        }
        TMSC.AuthorityConfig[] memory cfg = new TMSC.AuthorityConfig[](4);
        string[4] memory names = ["H1", "H2", "H3", "H4"];
        for (uint256 i = 0; i < 4; i++) {
            cfg[i] = TMSC.AuthorityConfig(vm.addr(key(string.concat(names[i], "-root"))), _one(vm.addr(key(string.concat(names[i], "-ca-admin")))));
        }
        LSC lsc = new LSC(LogDetailMode.COMPLETE_DETAILS);
        TMSC tmsc = new TMSC(Profile.REPAIRED_F, 0, lsc, cfg);
        gov = new Governance(
            Governance.Config(address(tmsc), FixtureConfig.F_WITNESS_SET_VERSION, ws, 3, FixtureConfig.GOVERNANCE_MAX_TTL, 0)
        );
        lsc.wire(address(0xB001), address(tmsc), address(0xB002));
        tmsc.wire(address(0xB002), address(0xB001));
        tmsc.wireGovernance(address(gov));
        lsc.seal();
        tmsc.seal();
    }

    // ------------------------------------------------------------------ vectors

    function _action(uint8 kind, address root, address[] memory admins, uint64 nonce)
        internal
        view
        returns (GovernanceAction memory)
    {
        return GovernanceAction(kind, root, admins, nonce, FixtureConfig.F_WITNESS_SET_VERSION, uint64(block.timestamp) + 60);
    }

    function _digest(GovernanceAction memory a) internal view returns (bytes32) {
        return HMBCHash.governanceActionDigest(a, FixtureConfig.PBC_CHAIN_ID, address(gov));
    }

    /// The first `n` witnesses' signatures over `digest`, sorted by signer address (QuorumLib order).
    function _sigs(bytes32 digest, uint256 n) internal view returns (bytes[] memory s) {
        uint256[] memory order = new uint256[](n);
        for (uint256 i = 0; i < n; i++) {
            order[i] = pks[i];
        }
        for (uint256 i = 1; i < n; i++) {
            for (uint256 j = i; j > 0 && vm.addr(order[j]) < vm.addr(order[j - 1]); j--) {
                (order[j], order[j - 1]) = (order[j - 1], order[j]);
            }
        }
        s = new bytes[](n);
        for (uint256 i = 0; i < n; i++) {
            (uint8 v, bytes32 r, bytes32 ss) = vm.sign(order[i], digest);
            s[i] = abi.encodePacked(r, ss, v);
        }
    }

    function _signed(string memory name, GovernanceAction memory a) internal view returns (string memory) {
        bytes32 d = _digest(a);
        string[] memory sigs = new string[](4);
        for (uint256 i = 0; i < 4; i++) {
            (uint8 v, bytes32 r, bytes32 s) = vm.sign(pks[i], d);
            sigs[i] = string.concat(
                "{", _kv("label", _q(FixtureConfig.witnessLabel(i))), ",", _kv("signer", _addr(vm.addr(pks[i]))), ",",
                _kv("signature", _q(vm.toString(abi.encodePacked(r, s, v)))), "}"
            );
        }
        return string.concat(
            "{", _kv("name", _q(name)), ",", _kv("message", _message(a)), ",", _kv("structHash", _b32(HMBCHash.hashGovernanceAction(a))),
            ",", _kv("digest", _b32(d)), ",", _kv("signatures", _arr(sigs)), "}"
        );
    }

    /// Executes `a` with the first `n` witnesses' sorted signatures and records the returned code.
    function _try(string memory name, GovernanceAction memory a, uint256 n, ErrorCode want)
        internal
        returns (string memory)
    {
        (bool ok, bytes memory ret) = address(gov).call(abi.encodeCall(Governance.execute, (a, _sigs(_digest(a), n))));
        ErrorCode got = ErrorCode.NONE;
        if (!ok) {
            require(ret.length == 36 && bytes4(ret) == Rejected.selector, "unexpected revert data");
            got = ErrorCode(uint8(uint256(bytes32(_slice4(ret)))));
        }
        if (got != want) mismatch = true;
        return string.concat(
            "{", _kv("name", _q(name)), ",", _kv("message", _message(a)), ",", _kv("signers", _u(n)), ",",
            _kv("expected", _q(CODES[uint8(want)])), ",", _kv("observed", _q(CODES[uint8(got)])), "}"
        );
    }

    function _boundary() internal returns (string memory) {
        h1 = vm.addr(key("H1-root"));
        h3 = vm.addr(key("H3-root"));
        a1 = vm.addr(key("H1-ca-admin-2"));
        string[] memory v = new string[](15);
        _nonceAndExpiry(v);
        _structure(v);
        _quorumAndEdge(v);
        v[14] = _substitution();
        return _arr(v);
    }

    function _nonceAndExpiry(string[] memory v) internal {
        v[0] = _try("nonce equals current (0)", _action(GOV_SET_CA_ADMINS, h1, _one(a1), 0), 3, ErrorCode.REPLAY);
        v[1] = _try("nonce is current + 2", _action(GOV_SET_CA_ADMINS, h1, _one(a1), 2), 3, ErrorCode.MALFORMED);
        GovernanceAction memory e = _action(GOV_SET_CA_ADMINS, h1, _one(a1), 1);
        e.expiresAt = uint64(block.timestamp);
        v[2] = _try("expiresAt equals now", e, 3, ErrorCode.EXPIRED);
        GovernanceAction memory far = _action(GOV_SET_CA_ADMINS, h1, _one(a1), 1);
        far.expiresAt = uint64(block.timestamp) + FixtureConfig.GOVERNANCE_MAX_TTL + 1;
        v[3] = _try("expiresAt is now + maxGovernanceTtl + 1", far, 3, ErrorCode.MALFORMED);
    }

    function _structure(string[] memory v) internal {
        v[4] = _try("admins [0]", _action(GOV_SET_CA_ADMINS, h1, new address[](1), 1), 3, ErrorCode.MALFORMED);
        address[] memory two = new address[](2);
        (two[0], two[1]) = (a1, a1);
        v[5] = _try("admins duplicate", _action(GOV_SET_CA_ADMINS, h1, two, 1), 3, ErrorCode.MALFORMED);
        two = new address[](2);
        (two[0], two[1]) = (address(0xA002), address(0xA001));
        v[6] = _try("admins descending", _action(GOV_SET_CA_ADMINS, h1, two, 1), 3, ErrorCode.MALFORMED);
        address[] memory nine = new address[](9);
        for (uint256 i = 0; i < 9; i++) {
            nine[i] = address(uint160(0xA001 + i));
        }
        v[7] = _try("admins 9 entries", _action(GOV_SET_CA_ADMINS, h1, nine, 1), 3, ErrorCode.MALFORMED);
        v[8] = _try("REMOVE with admins", _action(GOV_REMOVE_AUTHORITY, h3, _one(a1), 1), 3, ErrorCode.MALFORMED);
        v[9] = _try(
            "ADD with no admins", _action(GOV_ADD_AUTHORITY, vm.addr(key("H5-root")), new address[](0), 1), 3, ErrorCode.MALFORMED
        );
        v[10] = _try("action 4", _action(4, h1, _one(a1), 1), 3, ErrorCode.MALFORMED);
    }

    function _quorumAndEdge(string[] memory v) internal {
        GovernanceAction memory wsv = _action(GOV_SET_CA_ADMINS, h1, _one(a1), 1);
        wsv.witnessSetVersion = 1;
        v[11] = _try("witnessSetVersion 1 (the E set)", wsv, 3, ErrorCode.STALE_STATE);
        v[12] = _try("two of four signatures", _action(GOV_SET_CA_ADMINS, h1, _one(a1), 1), 2, ErrorCode.INSUFFICIENT_QUORUM);
        GovernanceAction memory edge = _action(GOV_SET_CA_ADMINS, h1, _one(a1), 1);
        edge.expiresAt = uint64(block.timestamp) + FixtureConfig.GOVERNANCE_MAX_TTL;
        v[13] = _try("expiresAt is now + maxGovernanceTtl (accepted; nonce 1 consumed)", edge, 3, ErrorCode.NONE);
    }

    /// Bit 6 baseline: a certificate signed over SET submitted as REMOVE (nonce 2, after v[13]).
    function _substitution() internal returns (string memory) {
        GovernanceAction memory set2 = _action(GOV_SET_CA_ADMINS, h1, new address[](0), 2);
        bytes[] memory s = _sigs(_digest(set2), 3);
        GovernanceAction memory asRemove =
            GovernanceAction(GOV_REMOVE_AUTHORITY, set2.root, set2.admins, set2.nonce, set2.witnessSetVersion, set2.expiresAt);
        (bool ok, bytes memory ret) = address(gov).call(abi.encodeCall(Governance.execute, (asRemove, s)));
        ErrorCode got = ok ? ErrorCode.NONE : ErrorCode(uint8(uint256(bytes32(_slice4(ret)))));
        if (got != ErrorCode.BAD_SIGNATURE) mismatch = true;
        return string.concat(
            "{", _kv("name", _q("SET(H1, []) certificate submitted as REMOVE(H1, []) (bit 6 clear)")), ",",
            _kv("signedMessage", _message(set2)), ",", _kv("submittedMessage", _message(asRemove)), ",",
            _kv("signers", _u(3)), ",", _kv("expected", _q("BAD_SIGNATURE")), ",", _kv("observed", _q(CODES[uint8(got)])), "}"
        );
    }

    /// Bit 6 (MUT_NO_GOV_ACTION_BINDING) encodes the action as 0; its baseline counterpart encodes 3.
    function _bit6() internal view returns (string memory) {
        GovernanceAction memory base = _action(GOV_SET_CA_ADMINS, vm.addr(key("H1-root")), new address[](0), 1);
        GovernanceAction memory zero = GovernanceAction(0, base.root, base.admins, base.nonce, base.witnessSetVersion, base.expiresAt);
        return string.concat(
            "{", _kv("note", _q("the mutant verifier hashes action := 0 and dispatches the submitted action; not a deployment")),
            ",", _kv("signedOverAction0", _signed("set-as-action-0", zero)), ",", _kv("baselineCounterpart", _signed("set", base)), "}"
        );
    }

    // ------------------------------------------------------------------ JSON

    function _domain() internal view returns (string memory) {
        return string.concat(
            "{", _kv("name", _q("HMBCGovernance")), ",", _kv("version", _q("1")), ",", _kv("chainId", _u(FixtureConfig.PBC_CHAIN_ID)),
            ",", _kv("verifyingContract", _addr(address(gov))), ",",
            _kv("separator", _b32(HMBCHash.domainSeparator(HMBCHash.GOVERNANCE_DOMAIN, FixtureConfig.PBC_CHAIN_ID, address(gov)))), "}"
        );
    }

    function _witnesses() internal view returns (string memory) {
        string[] memory w = new string[](4);
        for (uint256 i = 0; i < 4; i++) {
            w[i] = string.concat("{", _kv("label", _q(FixtureConfig.witnessLabel(i))), ",", _kv("address", _addr(vm.addr(pks[i]))), "}");
        }
        return _arr(w);
    }

    function _message(GovernanceAction memory a) internal pure returns (string memory) {
        string[] memory admins = new string[](a.admins.length);
        for (uint256 i = 0; i < a.admins.length; i++) {
            admins[i] = _addr(a.admins[i]);
        }
        return string.concat(
            "{", _kv("action", _u(a.action)), ",", _kv("root", _addr(a.root)), ",", _kv("admins", _arr(admins)), ",",
            _kv("nonce", _u(a.nonce)), ",", _kv("witnessSetVersion", _u(a.witnessSetVersion)), ",", _kv("expiresAt", _u(a.expiresAt)), "}"
        );
    }

    function _one(address a) internal pure returns (address[] memory xs) {
        xs = new address[](1);
        xs[0] = a;
    }

    function _slice4(bytes memory b) internal pure returns (bytes memory out) {
        out = new bytes(b.length - 4);
        for (uint256 i = 4; i < b.length; i++) {
            out[i - 4] = b[i];
        }
    }

    function _q(string memory s) internal pure returns (string memory) {
        return string.concat('"', s, '"');
    }

    function _kv(string memory k, string memory v) internal pure returns (string memory) {
        return string.concat(_q(k), ":", v);
    }

    function _u(uint256 x) internal pure returns (string memory) {
        return _q(vm.toString(x));
    }

    function _b32(bytes32 x) internal pure returns (string memory) {
        return _q(vm.toString(x));
    }

    function _addr(address a) internal pure returns (string memory) {
        bytes memory hexChars = "0123456789abcdef";
        bytes memory out = new bytes(42);
        out[0] = "0";
        out[1] = "x";
        uint160 v = uint160(a);
        for (uint256 i = 0; i < 20; i++) {
            uint8 b = uint8(v >> (8 * (19 - i)));
            out[2 + 2 * i] = hexChars[b >> 4];
            out[3 + 2 * i] = hexChars[b & 15];
        }
        return _q(string(out));
    }

    function _arr(string[] memory xs) internal pure returns (string memory out) {
        out = "[";
        for (uint256 i = 0; i < xs.length; i++) {
            out = string.concat(out, i == 0 ? "" : ",", xs[i]);
        }
        out = string.concat(out, "]");
    }
}
